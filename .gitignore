.DS_Store
/config.toml
/config.toml.bak
# 带时间戳与随机后缀的配置备份。里面是完整的凭据明文（含 api_key / client_secret
# / redis 密码），一次 `git add -A` 就会把它们全部发布出去，而 `/config.toml`
# 这条规则匹配不到它。
/config.toml.backup-*
/config.toml.tmp
/storage/
# Chrome 的登录 profile（含 cookie 与会话状态）。放在仓库内的那一份是路径拼错
# 造成的残留：多了一层 "MoneyPrinterTurbo"，于是它既不在 storage_policy 的保护
# 范围内，也没被上面的 /storage/ 覆盖。
/MoneyPrinterTurbo/
/.idea/
/app/services/__pycache__
/app/__pycache__/
/app/config/__pycache__/
/app/models/__pycache__/
/app/utils/__pycache__/
/*/__pycache__/*
.vscode
/**/.streamlit
__pycache__
logs/

node_modules
# VuePress 默认临时文件目录
/sites/docs/.vuepress/.temp
# VuePress 默认缓存目录
/sites/docs/.vuepress/.cache
# VuePress 默认构建生成的静态文件目录
/sites/docs/.vuepress/dist
# 模型目录
/models/
./models/*

venv/
.venv

# Debug and test files
CLAUDE.md
debug/
debug_*.py
test_*.py
!test/services/test_*.py
!test/test_*.py
streamlit.log
.coverage
coverage.xml
htmlcov/
.codegraph
/docs/superpowers
.understand-anything

# graphify knowledge-graph output: generated, ~40 MB, rebuilt with
# `graphify . --update --code-only`. Never commit it.
graphify-out/

# Local secrets. config.toml is already ignored, but .env must never
# be committed either.
.env
.env.*
!.env.example
